# =============================================================
# AUTO PROJECT — Variables d'environnement
# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier .env dans Git !
# =============================================================

# --- Serveur ---
PORT=5000

# --- Base de données MySQL ---
DB_HOST=mysql-db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=appuser123
DB_NAME=auto_project

# --- Sécurité JWT ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_MOI_SECRET_JWT_64_BYTES_HEX

# --- Chiffrement ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=CHANGE_MOI_CLE_CHIFFREMENT_32_CHARS

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Logs ---
# Niveau de log : error | warn | info | debug
LOG_LEVEL=info
NODE_ENV=production
